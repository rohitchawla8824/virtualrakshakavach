NODE_ENV=development
HOST=127.0.0.1
PORT=4000
MONGODB_URI=
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-characters
AUTH_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_TTL_DAYS=7
AUTH_SESSION_MAX_DAYS=30
BCRYPT_ROUNDS=12
FRONTEND_URL=http://127.0.0.1:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
LOG_LEVEL=info
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
ENABLE_DEV_SEED=false
# TEST MODE ONLY. Leave blank to disable online checkout.
# Obtain keys from the Razorpay Dashboard in Test Mode. Never use rzp_live_* keys here.
RAZORPAY_TEST_KEY_ID=
RAZORPAY_TEST_KEY_SECRET=
RAZORPAY_TEST_WEBHOOK_SECRET=